<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent/>
    <artifactId>kb-ai-core</artifactId>
    <name>kb-ai-core</name>
    <description>AI 核心模块：ChatClient 配置、Advisor、Prompt 管理、混合检索</description>

    <dependencies>
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>kb-infrastructure</artifactId>
        </dependency>

        <!-- Spring AI Chat Client -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>

        <!-- Spring AI RAG + Vector Store Advisor -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-rag</artifactId>
        </dependency>

        <!-- Chat Memory（3.1）：Redis 会话记忆仓储 + MessageWindowChatMemory 自动装配。
             2.0 GA 实证：RedisChatMemoryRepository 为 Jedis 形态（非 v1 文档的 RedisTemplate），
             starter 含 jedis 客户端 / redis 仓储 / chat-memory 自动配置三件套 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-chat-memory-repository-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store-advisor</artifactId>
        </dependency>

        <!-- Model Providers -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- v2.77（模型层批B）：deepseek starter 退役——主模型双形态（GLM/DeepSeek）
             均手工装配 OpenAI 兼容形态，starter 无装配面且阻塞 stream_usage 计账 -->

        <!-- MCP -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <!-- Actuator + Prometheus -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
    </dependencies>
</project>
