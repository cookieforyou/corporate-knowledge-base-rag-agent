<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent/>
    <artifactId>kb-infrastructure</artifactId>
    <name>kb-infrastructure</name>
    <description>基础设施模块：向量库双后端、Elasticsearch、Redis、MinIO、OCR 适配</description>

    <dependencies>
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>kb-domain</artifactId>
        </dependency>

        <!-- Spring AI Vector Store 多后端支持 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-milvus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <!-- Elasticsearch：starter 提供 ElasticsearchClient 自动装配（spring.elasticsearch.uris）-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-elasticsearch</artifactId>
        </dependency>

        <!-- Redis + Redisson -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>4.6.1</version>
        </dependency>

        <!-- MinIO -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.6.0</version>
            <exclusions>
                <!-- B5 治理（Phase 5 簇①）：kotlin-stdlib-common 2.0 起并入 kotlin-stdlib
                     且 2.x 无 jar，声明点排除；类由 kotlin-stdlib 2.4.10 承载 -->
                <exclusion>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-stdlib-common</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
            <exclusions>
                <!-- B5 治理（Phase 5 簇①）：同上——okio 3.6.0 传递链 -->
                <exclusion>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-stdlib-common</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 阿里云文档智能 DocMind 文档解析大模型版官方 SDK（2.2 深度解析链路；RAM AccessKey 鉴权；
             20220711 版本线才含 DocParser 三件套 API：
             SubmitDocParserJob/QueryDocParserStatus/GetDocParserResult，
             20220729 线仅贸易单证抽取）-->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>docmind_api20220711</artifactId>
            <version>2.0.14</version>
        </dependency>

        <!-- PDFBox：qwen-ocr 链路 PDF 按页渲染（版本与 Tika 传递依赖对齐） -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.7</version>
        </dependency>

        <!-- RestClient：qwen-ocr 多模态调用 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- Neo4j 官方 Java 驱动（簇④ GraphRAG）：原生 Bolt 直连，自建 GraphGateway，
             不引 Spring Data Neo4j（定案：图查询全走显式 Cypher，ORM 层无收益）。
             版本由 Boot BOM 托管（4.1.0 = 6.1.0，落码核验在案）。
             条件装配：rag.graph.enabled=false 时无 Driver Bean、无连接尝试（关闭态零变化）。 -->
        <dependency>
            <groupId>org.neo4j.driver</groupId>
            <artifactId>neo4j-java-driver</artifactId>
        </dependency>
    </dependencies>
</project>
