<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent/>
    <artifactId>kb-infrastructure</artifactId>
    <name>kb-infrastructure</name>
    <description>基础设施模块：向量库双后端、Elasticsearch、Redis、MinIO、OCR 适配</description>

    <dependencies>
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>kb-domain</artifactId>
        </dependency>

        <!-- Spring AI Vector Store 多后端支持 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-milvus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <!-- Elasticsearch：starter 提供 ElasticsearchClient 自动装配（spring.elasticsearch.uris）-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-elasticsearch</artifactId>
        </dependency>

        <!-- Redis + Redisson -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>4.6.1</version>
        </dependency>

        <!-- MinIO -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.6.0</version>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>

        <!-- DocMind 文档解析大模型版（2.2 深度解析链路；RAM AccessKey 鉴权；
             版本由父 POM dependencyManagement 锁定 2.0.14——20220711 版本线才含
             DocParser 三件套 API，20220729 线仅贸易单证抽取） -->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>docmind_api20220711</artifactId>
        </dependency>

        <!-- PDFBox：qwen-ocr 链路 PDF 按页渲染（版本与 Tika 传递依赖对齐） -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.7</version>
        </dependency>

        <!-- RestClient：qwen-ocr 多模态调用 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
    </dependencies>
</project>
