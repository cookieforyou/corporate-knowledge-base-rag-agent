<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent/>
    <artifactId>kb-admin</artifactId>
    <name>kb-admin</name>
    <description>运维后台模块：Chunk 管理（4.4）、索引重建（4.5）；经 kb-api 聚合装配
        （scanBasePackages 全域扫描），租户守卫沿用 fail-closed 口径</description>

    <dependencies>
        <!-- ETL 基座：ChunkCleanupService 软删管道 / EsIndexWriter / SanitizingTransformer /
             DocumentEtlService 蓝绿管线（传递 kb-infrastructure → kb-domain → kb-commons） -->
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>kb-etl</artifactId>
        </dependency>
        <!-- AiBusinessMetrics 业务指标（chunk 运维计数） -->
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>kb-ai-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 租户守卫：@AuthenticationPrincipal + Jwt 编译期类。kb-admin 不可依赖 kb-api
             （kb-api 聚合本模块，反向依赖成环），故不复用其 JwtUtils，直接消费
             OAuth2 Resource Server 解析后的 principal；claim 映射（owner→tenantId）
             与 JwtUtils 同源口径（Casdoor），见第 14 章 v2.33 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>
    </dependencies>
</project>
