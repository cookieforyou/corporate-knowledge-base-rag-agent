<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.enterprise</groupId>
    <artifactId>kb-rag-agent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>企业知识库 RAG Agent 工作台</name>
    <description>Enterprise Knowledge Base RAG Agent Workbench</description>

    <modules>
        <module>kb-commons</module>
        <module>kb-domain</module>
        <module>kb-infrastructure</module>
        <module>kb-etl</module>
        <module>kb-ai-core</module>
        <module>kb-ai-agent</module>
        <module>kb-api</module>
        <module>kb-admin</module>
        <module>kb-eval</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <!-- 2.0.5：1.20.1 的 docker-java 3.4 钉死 API 1.32，Docker Engine 29（最低 API 1.40+）
             全部请求 400；2.x 线 docker-java 3.7 兼容新引擎（2026-08-13 D3 实证） -->
        <testcontainers.version>2.0.5</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI BOM -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- victools jsonschema-module-jackson：spring-ai-bom 未管理此件，
                 openai-java SDK 传递的 4.38.0 会以最短路径优先覆盖 spring-ai 的 5.0.0，
                 致 .entity() 结构化输出 NoClassDefFoundError: JacksonSchemaModule。
                 5.0.0 自带旧名 JacksonModule 兼容垫片，且 openai-java 字节码不引用此模块（已核验） -->
            <dependency>
                <groupId>com.github.victools</groupId>
                <artifactId>jsonschema-module-jackson</artifactId>
                <version>5.0.0</version>
            </dependency>

            <!-- Internal Modules -->
            <dependency>
                <groupId>com.enterprise</groupId>
                <artifactId>kb-commons</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enterprise</groupId>
                <artifactId>kb-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enterprise</groupId>
                <artifactId>kb-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enterprise</groupId>
                <artifactId>kb-etl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enterprise</groupId>
                <artifactId>kb-ai-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enterprise</groupId>
                <artifactId>kb-ai-agent</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enterprise</groupId>
                <artifactId>kb-admin</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Testcontainers BOM -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- 测试 JVM 须与编译器同步开启 preview：javac 仅对实际使用 preview 语法的
                 class 打 65535 标记（如 ChatSessionService 的 JEP 443 未命名变量），
                 缺此 argLine 时 surefire 加载该类抛 UnsupportedClassVersionError -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--enable-preview</argLine>
                </configuration>
            </plugin>
            <!-- 依赖供应链基线（安全簇② B5，2026-08-17）：OWASP dependency-check
                 + CycloneDX SBOM。**不绑定生命周期**——显式调用形态，CI 门禁暂不
                 强制（定案：首跑全量报告入档观察误报率，转强制时机另议）。
                 扫描：mvn org.owasp:dependency-check-maven:aggregate
                 SBOM： mvn org.cyclonedx:cyclonedx-maven-plugin:makeAggregateBom
                 注：NVD 数据源建议配 API key（nvdApiKey 属性），无 key 限速显著 -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>13.0.0</version>
                <configuration>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                    <!-- 首跑不设失败阈值：failBuildOnCVSS 缺省 11（永不失败），
                         观察误报率后转强制时再下调（CI 门禁定案口径） -->
                    <skipProvidedScope>true</skipProvidedScope>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>2.9.3</version>
                <configuration>
                    <projectType>application</projectType>
                    <outputFormat>json</outputFormat>
                    <includeBomSerialNumber>true</includeBomSerialNumber>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
