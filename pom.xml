<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.enterprise</groupId>
    <artifactId>kb-rag-agent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>企业知识库 RAG Agent 工作台</name>
    <description>Enterprise Knowledge Base RAG Agent Workbench</description>

    <modules>
        <module>kb-commons</module>
        <module>kb-domain</module>
        <module>kb-infrastructure</module>
        <module>kb-etl</module>
        <module>kb-ai-core</module>
        <module>kb-ai-agent</module>
        <module>kb-api</module>
        <module>kb-admin</module>
        <module>kb-eval</module>
        <module>kb-loadtest</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <!-- Gatling 压测（簇⑥ 批5 v2.59）：独立模块 kb-loadtest，gatling:test 显式触发，
             Simulation 类命名 *Simulation 避开 surefire，默认 mvn test 只编译不跑压测 -->
        <gatling.version>3.15.1</gatling.version>
        <gatling-maven-plugin.version>4.21.10</gatling-maven-plugin.version>
        <!-- 2.0.5：1.20.1 的 docker-java 3.4 钉死 API 1.32，Docker Engine 29（最低 API 1.40+）
             全部请求 400；2.x 线 docker-java 3.7 兼容新引擎（2026-08-13 D3 实证） -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <!-- B5 漏洞治理（Phase 5 簇①，2026-08-23）：覆盖 Boot 4.1.0 BOM 管理版本，
             清零 2026-08-18 dependency-check 基线 11 项 CRITICAL（8 CVE）——
             tomcat 4 CVE（53434/55276/59083/59084）、httpclient5 CVE-2026-71290、
             kotlin CVE-2026-53914（含 stdlib-common 1.9.10 残留）、netty CVE-2026-56820。
             全部同线补丁/次版本升级（契约不变），回归验证后复扫确认。 -->
        <tomcat.version>11.0.25</tomcat.version>
        <httpclient5.version>5.6.4</httpclient5.version>
        <kotlin.version>2.4.10</kotlin.version>
        <netty.version>4.2.17.Final</netty.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI BOM -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- victools jsonschema-module-jackson：spring-ai-bom 未管理此件，
                 openai-java SDK 传递的 4.38.0 会以最短路径优先覆盖 spring-ai 的 5.0.0，
                 致 .entity() 结构化输出 NoClassDefFoundError: JacksonSchemaModule。
                 5.0.0 自带旧名 JacksonModule 兼容垫片，且 openai-java 字节码不引用此模块（已核验） -->
            <dependency>
                <groupId>com.github.victools</groupId>
                <artifactId>jsonschema-module-jackson</artifactId>
                <version>5.0.0</version>
            </dependency>

            <!-- B5 漏洞治理（Phase 5 簇①）：milvus-sdk-java CVE-2026-26190（CRITICAL 9.8），
                 spring-ai-milvus-store 2.0.0 声明的 2.5.8 经此覆盖至 2.5 线最新补丁版；
                 3.x 为 API 重写线（与 spring-ai-milvus-store 2.0.0 不兼容），不升 -->
            <dependency>
                <groupId>io.milvus</groupId>
                <artifactId>milvus-sdk-java</artifactId>
                <version>2.5.17</version>
            </dependency>

            <!-- B5 漏洞治理（Phase 5 簇①）：kotlin-stdlib-common（CVE-2026-53914）自 Kotlin 2.0
                 起已并入 kotlin-stdlib，2.x 线不再发布 jar（镜像 404 实证）——无法钉版本升级，
                 治理形态 = 声明点排除出依赖图（okhttp/minio/openai-java 链，见各模块 pom）；
                 其 JVM 类由 kotlin-stdlib 2.4.10 全量承载，运行时零缺失（全模块回归背书） -->

            <!-- Internal Modules -->
            <dependency>
                <groupId>com.enterprise</groupId>
                <artifactId>kb-commons</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enterprise</groupId>
                <artifactId>kb-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enterprise</groupId>
                <artifactId>kb-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enterprise</groupId>
                <artifactId>kb-etl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enterprise</groupId>
                <artifactId>kb-ai-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enterprise</groupId>
                <artifactId>kb-ai-agent</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.enterprise</groupId>
                <artifactId>kb-admin</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Testcontainers BOM -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Gatling（仅 kb-loadtest 消费，test scope 声明在子模块） -->
            <dependency>
                <groupId>io.gatling.highcharts</groupId>
                <artifactId>gatling-charts-highcharts</artifactId>
                <version>${gatling.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- 测试 JVM 须与编译器同步开启 preview：javac 仅对实际使用 preview 语法的
                 class 打 65535 标记（如 ChatSessionService 的 JEP 443 未命名变量），
                 缺此 argLine 时 surefire 加载该类抛 UnsupportedClassVersionError -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--enable-preview</argLine>
                </configuration>
            </plugin>
            <!-- 依赖供应链基线（安全簇② B5，2026-08-17）：OWASP dependency-check
                 + CycloneDX SBOM。**不绑定生命周期**——显式调用形态，CI 门禁暂不
                 强制（定案：首跑全量报告入档观察误报率，转强制时机另议）。
                 扫描：mvn org.owasp:dependency-check-maven:aggregate
                 SBOM： mvn org.cyclonedx:cyclonedx-maven-plugin:makeAggregateBom
                 注：NVD 数据源建议配 API key（nvdApiKey 属性），无 key 限速显著 -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>13.0.0</version>
                <configuration>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                    <!-- 首跑不设失败阈值：failBuildOnCVSS 缺省 11（永不失败），
                         观察误报率后转强制时再下调（CI 门禁定案口径） -->
                    <skipProvidedScope>true</skipProvidedScope>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>2.9.3</version>
                <configuration>
                    <projectType>application</projectType>
                    <outputFormat>json</outputFormat>
                    <includeBomSerialNumber>true</includeBomSerialNumber>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
