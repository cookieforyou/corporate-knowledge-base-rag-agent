<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent/>
    <artifactId>kb-api</artifactId>
    <name>kb-api</name>
    <description>API 模块：REST Controller、SSE 接口（Spring Boot 启动入口）</description>

    <dependencies>
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>kb-etl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>kb-ai-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>kb-ai-agent</artifactId>
        </dependency>
        <!-- 运维后台（Phase 4 簇③ 首建）：Chunk 运维 4.4 + 索引重建 4.5；
             scanBasePackages 全域扫描自动装配其 Controller/Service -->
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>kb-admin</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- MCP Server 宿主（Phase 4 簇⑤ 4.10）：Streamable HTTP 传输（/mcp）+
             @McpTool 注解扫描自动收编 kb-ai-agent 三件套工具；身份治理经
             SecurityConfig /mcp authenticated + McpIdentityGuard（租户/scope fail-closed）。
             版本经父 POM spring-ai BOM 管理；spring-ai#6465（starter 传递 Boot 依赖）
             由 Boot BOM 导入钉死 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>

        <!-- 观测地基（Phase 4 簇①）：Micrometer Observation → OTel 桥接 → OTLP 导出（Langfuse Cloud）
             Boot 4.1 模块化形态：tracing-opentelemetry 模块含核心 tracing + OTel 桥接装配 + OTLP 自动配置
             （OtlpTracingAutoConfiguration，属性前缀 management.opentelemetry.tracing.export.otlp.*）；
             bridge-otel 提供 Observation→Span 桥，exporter-otlp 提供 OTLP/HTTP 序列化导出。
             仅 kb-api 宿主引入——kb-eval 评估宿主零影响（不挂导出链）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- 簇① trace 碎片化修复：Reactor/异步边界 ThreadLocal 传播（tracing 上下文
             随 Reactor Context 捕获/恢复，span 父子关系复原）。Boot BOM 管理版本 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
