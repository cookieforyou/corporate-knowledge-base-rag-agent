# ============================================================
# kb-rag-agent 生产环境变量模板（Phase 4 簇⑥ 4.11，v2.55）
#
# 用法：cp .env.example .env → 填实际值 → chmod 600 .env
# .env 不入 git（根 .gitignore 已含）；本模板仅占位零真实凭据。
#
# 主机名约定（v2.55 定案）：容器内 host.docker.internal = ECS 宿主
# （compose extra_hosts host-gateway）——PG 原生安装与既有 compose
# 服务的宿主端口映射两形态统一经此连接。存量 compose 若暴露端口
# 非下列缺省，按实改端口。
# ============================================================

# ── 镜像（禁 latest）──────────────────────────
KB_IMAGE_TAG=v1.0.0-REPLACE_ME

# ── 应用 ─────────────────────────────────────
SERVER_PORT=8090
SPRING_PROFILES_ACTIVE=prod
# 进程堆参数（可选，2 核 ECS 建议 1.5-2G 上限留余量给堆外）
JAVA_OPTS=-Xms1g -Xmx2g

# ── PostgreSQL（宿主机原生安装）───────────────
DB_URL=jdbc:postgresql://host.docker.internal:5432/kb_rag_agent
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_POOL_MAX=20
DB_POOL_MIN=5
# Flyway（v2.54 接入，缺省即可；现网首跑 baseline 登记见用户侧清单 F1）
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# ── Elasticsearch（既有 compose，宿主端口映射）──
ES_URIS=http://host.docker.internal:9200
ES_USERNAME=CHANGE_ME
ES_PASSWORD=CHANGE_ME

# ── Redis（既有 compose；REDIS_DB 必须 0——坑位⑦）─
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# ── MinIO（既有 compose）──────────────────────
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=kb-documents

# ── 向量库（默认 milvus，既有 compose）─────────
KB_VECTOR_STORE_PROVIDER=milvus
KB_MILVUS_HOST=host.docker.internal
KB_MILVUS_PORT=19530
KB_MILVUS_USERNAME=CHANGE_ME
KB_MILVUS_PASSWORD=CHANGE_ME
KB_MILVUS_COLLECTION=kb_embeddings
KB_MILVUS_DATABASE=
# 切 pgvector 形态时：KB_VECTOR_STORE_PROVIDER=pgvector + KB_PGVECTOR_* 组

# ── 认证（Casdoor OAuth2 Resource Server）─────
JWT_ISSUER_URI=CHANGE_ME

# ── CORS / WS（安全簇② B1：显式白名单，生产改实域）─
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
WS_ALLOWED_ORIGINS=http://localhost:5173

# ── LLM 主备（GLM-5.3-Flash 主[缺省] + qwen3.8-flash 备；DeepSeek 回落形态）─
# 主模型双形态开关（v2.77）：glm | deepseek——一切即切，主答/工具链生成走所选形态；
# 路由/改写/L2 二判等轻任务恒挂备用 qwen3.8-flash（思考关），不受开关影响
RAG_ROUTING_PRIMARY_PROVIDER=glm
# GLM 形态（智谱 OpenAI 兼容端点；强制思考不可关，effort 生产档 low——2026-09-01
# 冒烟定案：服务端 max 档思维链 20-31s 级延迟；2026-09-02 门禁对照证伪 high 无增益
# （CA/HR 四轮治理全证伪，根因模型面轻度幻觉带，16 章 v2.96）；可调 low|high|max）
ZHIPU_API_KEY=CHANGE_ME
ZHIPU_MODEL=glm-5.3-flash
#ZHIPU_REASONING_EFFORT=low
#ZHIPU_TEMPERATURE=0.2
# DeepSeek 回落形态（provider=deepseek 时生效；思考缺省显式关闭——官方默认开且
# effort=high，成本/延迟双高；采样参数仅思考关闭后生效）
#DEEPSEEK_API_KEY=CHANGE_ME
#DEEPSEEK_MODEL=deepseek-v4-flash
#DEEPSEEK_THINKING_TYPE=disabled
#DEEPSEEK_REASONING_EFFORT=
DASHSCOPE_API_KEY=CHANGE_ME
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
# 备用生成模型（rag.routing.fallback.* 缺省即百炼端点 + DASHSCOPE_API_KEY 回落）
RAG_ROUTING_FALLBACK_ENABLED=true

# ── Rerank ───────────────────────────────────
RERANK_ENDPOINT=CHANGE_ME
RERANK_MODEL=qwen3-rerank

# ── 可观测（簇①）─────────────────────────────
TRACING_OTLP_ENABLED=false
TRACING_SAMPLING=1.0
LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
LANGFUSE_OTLP_AUTH=CHANGE_ME_BASE64_pk_sk
RAG_OBSERVABILITY_LOG_CONTENT=false

# ── 护栏词表源（v2.53 DB 单轨；回滚阀门置 file）─
RAG_GUARDRAIL_RULES_SOURCE=db
RAG_GUARDRAIL_RULES_EXPORT_DIR=/rules

# ── 解析支线（DocMind 深解析按需；NATIVE 可全空）─
KB_PARSING_PROVIDER=
KB_PARSING_DEEP_BY_DEFAULT=false
DOCMIND_ENDPOINT=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# ── AppCDS 训练（compose tools profile 消费）──
CDS_TRAIN_TIMEOUT=150

# ── Neo4j 图谱（簇④ GraphRAG；第二台 ECS 自托管 Community 实例）──
# 连接事实源：kb-infrastructure application-infra.yml spring.neo4j.*。
# 启用须同步 RAG_GRAPH_ENABLED=true（rag.graph.enabled 总开关，缺省关）。
NEO4J_URI=bolt://CHANGE_ME_NEO4J_HOST:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT_SECONDS=10
NEO4J_QUERY_TIMEOUT_SECONDS=5
NEO4J_LIVENESS_CHECK_SECONDS=60

# ── 备份与灾备（批3，v2.57；宿主侧脚本消费，非容器 env）──
# pg-backup.sh / pg-restore-drill.sh 运行于 ECS 宿主（PG 原生安装），
# 主机名按宿主侧地址填写（非 host.docker.internal）。
# DB 凭据复用上方 DB_USERNAME/DB_PASSWORD；MinIO 凭据复用 MINIO_*。
BACKUP_PG_HOST=127.0.0.1
BACKUP_PG_PORT=5432
BACKUP_PG_DATABASE=kb_rag_agent
# pg_dump/psql 不在 PATH 时指 PG bin 目录（如 /usr/pgsql-18/bin）
BACKUP_PG_BIN=
BACKUP_MINIO_ENDPOINT=http://127.0.0.1:9000
BACKUP_MINIO_ALIAS=kbbackup
BACKUP_BUCKET=kb-backups
BACKUP_LOCAL_DIR=/opt/kb-rag-agent/backups
BACKUP_LOCAL_RETAIN_DAYS=7
# 恢复演练预装扩展（空白分隔；vector 需超级用户或演练库已装）
BACKUP_PG_EXTENSIONS=vector

# neo4j-backup.sh（簇④ 批3；第二台 ECS 宿主侧执行，停备窗口秒级——
# 窗口内图路降级空路，RAG 主链不受影响）
BACKUP_NEO4J_DATABASE=neo4j
BACKUP_NEO4J_ADMIN_BIN=
# systemd 服务名（默认形态）；docker 形态填容器名并置 NEO4J_SERVICE 为空
BACKUP_NEO4J_SERVICE=neo4j
BACKUP_NEO4J_CONTAINER=

# ── 监控栈（docker-compose.monitoring.yml，v2.56 批2）──
# Grafana 管理员口令（未设即拒绝启动，:? 守卫；本地核验可临时设 admin）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# 资源限额（可选，缺省即 compose 内定值 1G/512M/256M/128M）
PROMETHEUS_MEM_LIMIT=1G
GRAFANA_MEM_LIMIT=512M
JAEGER_MEM_LIMIT=256M
NODE_EXPORTER_MEM_LIMIT=128M
