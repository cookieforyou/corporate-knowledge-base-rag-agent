<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent/>
    <artifactId>kb-eval</artifactId>
    <name>kb-eval</name>
    <description>AI 评估模块：Golden Dataset、评估指标、CI 自动评估（Phase 2.16 最小基线）</description>

    <dependencies>
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>kb-ai-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <!-- OpenAI Java SDK OkHttp 传输（Judge 模型客户端用；spring-ai BOM 不管理此 artifact，
             版本与 starter 传递的 openai-java-core 保持一致） -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java-client-okhttp</artifactId>
            <version>4.41.0</version>
            <exclusions>
                <!-- B5 治理（Phase 5 簇①）：kotlin-stdlib-common 2.0 起并入 kotlin-stdlib
                     且 2.x 无 jar，声明点排除；类由 kotlin-stdlib 2.4.10 承载 -->
                <exclusion>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-stdlib-common</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 簇④ 四轮热修补防：Neo4j 网关真跑 IT（Cypher 语法/语义仅真库可验，
             mock 单测盲视——列表推导式语序错实证）；镜像钉生产同版本 5.26.29 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-neo4j</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 簇⑥ D3：文档生命周期 IT（reparse/replace 蓝绿/软删）直测 DocumentEtlService -->
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>kb-etl</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 可独立运行：mvn spring-boot:run -pl kb-eval -Dspring-boot.run.profiles=ci -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- 簇⑥ D3 集成测试：*IT.java 经 failsafe 在 mvn verify 执行（Docker 必需，
                 无 Docker 环境加 -DskipITs） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <!-- 父 POM 编译带 enable-preview，fork JVM 必须同步（同 surefire argLine） -->
                    <argLine>--enable-preview</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
