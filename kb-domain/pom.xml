<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent/>
    <artifactId>kb-domain</artifactId>
    <name>kb-domain</name>
    <description>领域模块：JPA Entity、Repository、VO、枚举</description>

    <dependencies>
        <dependency>
            <groupId>com.enterprise</groupId>
            <artifactId>kb-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <!-- Flyway 迁移版本化（Phase 4 簇⑥ 4.11）：schema 事实源归本模块
             （db/migration/），kb-api 运行时宿主经 Boot 自动配置触发迁移。
             starter 传递 flyway-core 12.4.0（Boot 4.1 BOM 管理）；
             flyway-database-postgresql 须显式声明——Flyway 10+ 数据库模块
             拆分，缺失即 "Unsupported Database: PostgreSQL 18" 启动失败
             （Boot #49012 实证登记） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
    </dependencies>
</project>
